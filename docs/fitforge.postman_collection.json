{
  "info": {
    "name": "FitForge API",
    "description": "# Setup\n1. Set `baseUrl` (default http://localhost:3303)\n2. Set `accessToken` from auth-service\n\nAll routes use Bearer auth unless noted.\n\n# Response envelope\n```json\n{ \"success\": true, \"message\": \"...\", \"data\": {} }\n```\n\n# Phases\n- **01** Fitness Profile (Phase 1)\n- **02** Transformation (Phase 2)\n- **03** Foods, Food Preferences & Nutrition Preferences (Phase 3)\n- **04** AI Diet Planner (Phase 4)\n- **05** Meal Planning Engine (Phase 5)\n- **06** Daily Check-ins / Execution Events\n- **07** Progress Tracking & Analytics (Phase 7)\n- **08** Daily Execution + AI Coach (Phase 8)
- **08.2** Daily Dashboard & Compliance Engine
- **08.3** AI Coach (Context → Prompt → Gemini → Validator → Storage)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3303" },
    { "key": "accessToken", "value": "" },
    { "key": "transformationId", "value": "" },
    { "key": "foodId", "value": "" },
    { "key": "dietPlanId", "value": "" },
    { "key": "mealPlanId", "value": "" },
    { "key": "mealItemId", "value": "" },
    { "key": "progressPhotoId", "value": "" },
    { "key": "workoutPlanDayId", "value": "" },
    { "key": "workoutSessionId", "value": "" },
    { "key": "workoutExerciseId", "value": "" },
    { "key": "setId", "value": "" },
    { "key": "aiSessionId", "value": "" },
    { "key": "aiHistoryId", "value": "" },
    { "key": "imageId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 — Fitness Profile (Phase 1)",
      "item": [
        { "name": "GET Physique Goals", "request": { "method": "GET", "url": "{{baseUrl}}/fitness/goals" } },
        { "name": "GET Profile", "request": { "method": "GET", "url": "{{baseUrl}}/fitness/profile" } },
        { "name": "GET Plans Summary", "request": { "method": "GET", "url": "{{baseUrl}}/fitness/plans", "description": "Nutrition dailyTarget/proteinGoal + workout frequency/focusArea for plan-ready screen" } },
        { "name": "POST Create Profile", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/fitness/profile", "body": { "mode": "raw", "raw": "{\n  \"age\": 28,\n  \"gender\": \"male\",\n  \"heightCm\": 180,\n  \"weightKg\": 85,\n  \"activityLevel\": \"moderate\",\n  \"fitnessGoal\": \"fat_loss\",\n  \"physiqueGoalId\": \"lean\",\n  \"dietType\": \"high_protein\",\n  \"workoutExperience\": \"intermediate\",\n  \"workoutDaysPerWeek\": 4,\n  \"targetWeightKg\": 75,\n  \"targetBodyFatPercent\": 12,\n  \"allergies\": \"None\",\n  \"onboardingCompleted\": true\n}" }, "description": "onboardingCompleted:true generates transformation (+ async diet/workout) and returns plans summary" } },
        { "name": "PATCH Update Profile", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/fitness/profile", "body": { "mode": "raw", "raw": "{\n  \"weightKg\": 73,\n  \"fitnessGoal\": \"fat_loss\",\n  \"onboardingCompleted\": true\n}" } } }
      ]
    },
    {
      "name": "02 — Transformation (Phase 2)",
      "item": [
        { "name": "POST Generate", "request": { "method": "POST", "url": "{{baseUrl}}/transformation/generate" } },
        { "name": "GET Active", "request": { "method": "GET", "url": "{{baseUrl}}/transformation/active" } },
        { "name": "GET History", "request": { "method": "GET", "url": "{{baseUrl}}/transformation/history?page=1&limit=20" } },
        { "name": "GET Milestones", "request": { "method": "GET", "url": "{{baseUrl}}/transformation/{{transformationId}}/milestones" } }
      ]
    },
    {
      "name": "03 — Foods (Phase 3)",
      "item": [
        { "name": "GET Search Foods", "request": { "method": "GET", "url": "{{baseUrl}}/foods?page=1&limit=20&search=paneer&category=protein" } },
        { "name": "GET Search Foods (carbs alias)", "request": { "method": "GET", "url": "{{baseUrl}}/foods?page=1&limit=20&category=carbs" } },
        { "name": "GET Food Categories", "request": { "method": "GET", "url": "{{baseUrl}}/foods/categories" } },
        { "name": "POST Custom Food", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/foods/custom", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mom's Paneer Curry\",\n  \"category\": \"protein\",\n  \"dietType\": \"veg\",\n  \"servingSize\": \"1 bowl\",\n  \"calories\": 320,\n  \"protein\": 18,\n  \"carbs\": 12,\n  \"fats\": 22\n}" } } },
        { "name": "POST Create Food (admin)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/foods", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Egg\",\n  \"category\": \"protein\",\n  \"dietType\": \"eggetarian\",\n  \"servingSize\": \"1 large\",\n  \"calories\": 78,\n  \"protein\": 6,\n  \"carbs\": 0.6,\n  \"fats\": 5\n}" } } },
        { "name": "PATCH Update Food Category", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/foods/{{foodId}}", "body": { "mode": "raw", "raw": "{\n  \"category\": \"grain\"\n}" } } },
        { "name": "PATCH Update Food Image", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/foods/{{foodId}}", "body": { "mode": "raw", "raw": "{\n  \"imageUrl\": \"https://cdn.example.com/uploads/userId/food/uuid/medium.webp\"\n}" }, "description": "Catalog foods require admin. Custom foods: owner only. Upload via POST /images type=food first." } },
        { "name": "PATCH Remove Food Category", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/foods/{{foodId}}", "body": { "mode": "raw", "raw": "{\n  \"category\": null\n}" } } },
        { "name": "GET Food By ID", "request": { "method": "GET", "url": "{{baseUrl}}/foods/{{foodId}}" } }
      ]
    },
    {
      "name": "03 — Food Preferences (Phase 3)",
      "item": [
        { "name": "GET Food Preferences", "request": { "method": "GET", "url": "{{baseUrl}}/food-preferences" } },
        { "name": "POST Add Preference", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/food-preferences", "body": { "mode": "raw", "raw": "{\n  \"foodId\": \"{{foodId}}\",\n  \"preferenceType\": \"favorite\"\n}" } } },
        { "name": "PATCH Replace Preferences", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/food-preferences", "body": { "mode": "raw", "raw": "{\n  \"favorites\": [\"{{foodId}}\"],\n  \"available\": [],\n  \"restricted\": []\n}" } } },
        { "name": "DELETE Preference By Food ID", "request": { "method": "DELETE", "url": "{{baseUrl}}/food-preferences/{{foodId}}" } }
      ]
    },
    {
      "name": "03 — Nutrition Preferences (Phase 3)",
      "item": [
        { "name": "GET Nutrition Preferences", "request": { "method": "GET", "url": "{{baseUrl}}/nutrition-preferences" } },
        { "name": "POST Nutrition Preferences", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/nutrition-preferences", "body": { "mode": "raw", "raw": "{\n  \"budgetCategory\": \"moderate\",\n  \"preferredCuisine\": \"indian\",\n  \"mealsPerDay\": 4,\n  \"cookingTimeMinutes\": 30,\n  \"preferredMealTiming\": \"flexible\"\n}" } } },
        { "name": "PATCH Nutrition Preferences", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/nutrition-preferences", "body": { "mode": "raw", "raw": "{\n  \"mealsPerDay\": 5,\n  \"cookingTimeMinutes\": 45\n}" } } },
        { "name": "DELETE Nutrition Preferences", "request": { "method": "DELETE", "url": "{{baseUrl}}/nutrition-preferences" } }
      ]
    },
    {
      "name": "04 — AI Diet Planner (Phase 4)",
      "item": [
        { "name": "POST Generate Diet (Phase 4)", "request": { "method": "POST", "url": "{{baseUrl}}/diet/generate", "description": "AI → validate → save raw JSON on diet_plans → normalize to meal_plans/items" } },
        { "name": "POST Regenerate Diet (Phase 4)", "request": { "method": "POST", "url": "{{baseUrl}}/diet/regenerate" } },
        { "name": "POST Generate targets (legacy)", "request": { "method": "POST", "url": "{{baseUrl}}/diet/generate-targets" } },
        { "name": "POST From targets (legacy)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/diet/from-targets", "body": { "mode": "raw", "raw": "{\n  \"goal\": \"muscle_gain\",\n  \"dailyCalories\": 2800,\n  \"protein\": 150,\n  \"carbs\": 320,\n  \"fats\": 80\n}" } } },
        { "name": "POST Create diet (legacy)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/diet", "body": { "mode": "raw", "raw": "{\n  \"goal\": \"muscle_gain\",\n  \"caloriesTarget\": 2800,\n  \"proteinTarget\": 150,\n  \"carbsTarget\": 320,\n  \"fatsTarget\": 80\n}" } } },
        { "name": "GET Active Diet", "request": { "method": "GET", "url": "{{baseUrl}}/diet/active" } },
        { "name": "GET Diet History", "request": { "method": "GET", "url": "{{baseUrl}}/diet/history?page=1&limit=20" } },
        { "name": "POST Activate Diet (legacy)", "request": { "method": "POST", "url": "{{baseUrl}}/diet/{{dietPlanId}}/activate" } },
        { "name": "DELETE Diet (Phase 4)", "request": { "method": "DELETE", "url": "{{baseUrl}}/diet/{{dietPlanId}}" } },
        { "name": "GET Diet Planner Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/diet/planner" } },
        { "name": "PATCH Hydration", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/diet/planner/hydration", "body": { "mode": "raw", "raw": "{\n  \"amountMl\": 250\n}" } } }
      ]
    },
    {
      "name": "05 — Meal Planning (Phase 5)",
      "item": [
        { "name": "POST Generate from active diet", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/meal-plans/generate", "body": { "mode": "raw", "raw": "{\n  \"planType\": \"weekly\"\n}" } } },
        { "name": "GET Active Meal Plan", "request": { "method": "GET", "url": "{{baseUrl}}/meal-plans/active" } },
        { "name": "GET Meal Plan By ID", "request": { "method": "GET", "url": "{{baseUrl}}/meal-plans/{{mealPlanId}}" } },
        { "name": "GET History", "request": { "method": "GET", "url": "{{baseUrl}}/meal-plans/history?page=1&limit=20" } },
        { "name": "GET Today", "request": { "method": "GET", "url": "{{baseUrl}}/meal-plans/today" } },
        { "name": "GET Nutrition Summary", "request": { "method": "GET", "url": "{{baseUrl}}/meal-plans/nutrition-summary" } },
        { "name": "POST Complete Meal", "request": { "method": "POST", "url": "{{baseUrl}}/meal-plans/{{mealItemId}}/complete" } },
        { "name": "POST Skip Meal", "request": { "method": "POST", "url": "{{baseUrl}}/meal-plans/{{mealItemId}}/skip" } },
        { "name": "POST Replace Meal", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/meal-plans/{{mealItemId}}/replace", "body": { "mode": "raw", "raw": "{\n  \"foodId\": \"{{foodId}}\",\n  \"quantity\": 1\n}" } } }
      ]
    },
    {
      "name": "06 — Daily Check-ins / Execution Events",
      "item": [
        { "name": "POST Hydration Log", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/checkins/hydration", "body": { "mode": "raw", "raw": "{\n  \"amountMl\": 250\n}" }, "description": "Raw hydration event → rebuilds DailyCheckin.waterIntakeMl" } },
        { "name": "POST Workout Session Log", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/checkins/workout-sessions", "body": { "mode": "raw", "raw": "{\n  \"workoutPlanDayId\": \"{{workoutPlanDayId}}\",\n  \"durationMinutes\": 45,\n  \"caloriesBurned\": 320,\n  \"status\": \"completed\"\n}" } } },
        { "name": "GET Today Workout Sessions", "request": { "method": "GET", "url": "{{baseUrl}}/checkins/workout-sessions/today" } },
        { "name": "POST Refresh Daily Summary", "request": { "method": "POST", "url": "{{baseUrl}}/checkins/refresh", "description": "Rebuild DailyCheckin from meal/hydration/workout/progress events" } },
        { "name": "GET Today Score", "request": { "method": "GET", "url": "{{baseUrl}}/checkins/today" } },
        { "name": "POST Check-in (legacy overrides ok)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/checkins", "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Felt strong\"\n}" } } },
        { "name": "GET Check-ins", "request": { "method": "GET", "url": "{{baseUrl}}/checkins?page=1&limit=20" } },
        { "name": "GET Check-in Stats", "request": { "method": "GET", "url": "{{baseUrl}}/checkins/stats" } }
      ]
    },
    {
      "name": "07 — Progress Tracking (Phase 7)",
      "item": [
        { "name": "POST Progress Log", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/progress", "body": { "mode": "raw", "raw": "{\n  \"weightKg\": 78.5,\n  \"bodyFatPercentage\": 16.2,\n  \"waistCm\": 82,\n  \"chestCm\": 102,\n  \"armCm\": 36,\n  \"thighCm\": 56,\n  \"notes\": \"Feeling strong\"\n}" } } },
        { "name": "GET Latest Progress", "request": { "method": "GET", "url": "{{baseUrl}}/progress/latest" } },
        { "name": "GET Progress History", "request": { "method": "GET", "url": "{{baseUrl}}/progress/history?page=1&limit=20&from=2026-01-01&to=2026-07-11" } },
        { "name": "GET Progress Analytics", "request": { "method": "GET", "url": "{{baseUrl}}/progress/analytics" } },
        { "name": "GET Progress Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/progress/dashboard", "description": "Latest + analytics + narrative insights (lost Xkg / compliance / ETA pace)" } },
        { "name": "POST Presign Upload (R2)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/uploads/presigned-url", "body": { "mode": "raw", "raw": "{\n  \"fileName\": \"front.jpg\",\n  \"contentType\": \"image/jpeg\",\n  \"size\": 245000,\n  \"category\": \"progress\",\n  \"photoType\": \"front\"\n}" } } },
        { "name": "POST Progress Photos", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/progress/photos", "body": { "mode": "raw", "raw": "{\n  \"frontImageUrl\": \"https://cdn.example.com/uploads/user/front.jpg\",\n  \"sideImageUrl\": \"https://cdn.example.com/uploads/user/side.jpg\",\n  \"backImageUrl\": \"https://cdn.example.com/uploads/user/back.jpg\"\n}" } } },
        { "name": "GET Progress Photos", "request": { "method": "GET", "url": "{{baseUrl}}/progress/photos?page=1&limit=20" } },
        { "name": "DELETE Progress Photo", "request": { "method": "DELETE", "url": "{{baseUrl}}/progress/photos/{{progressPhotoId}}" } }
      ]
    },
    {
      "name": "08 — Daily Execution + AI Coach (Phase 8)",
      "item": [
        { "name": "POST Complete Meal", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/meals/{{mealItemId}}/complete", "body": { "mode": "raw", "raw": "{\n  \"consumedQuantity\": 1.0,\n  \"notes\": \"Finished all\"\n}" } } },
        { "name": "POST Partial Meal", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/meals/{{mealItemId}}/partial", "body": { "mode": "raw", "raw": "{\n  \"consumedQuantity\": 0.5\n}" } } },
        { "name": "POST Skip Meal", "request": { "method": "POST", "url": "{{baseUrl}}/meals/{{mealItemId}}/skip" } },
        { "name": "POST Replace Meal", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/meals/{{mealItemId}}/replace", "body": { "mode": "raw", "raw": "{\n  \"foodId\": \"{{foodId}}\"\n}" } } },
        { "name": "POST Generate AI Workout", "request": { "method": "POST", "url": "{{baseUrl}}/workouts/generate-ai", "description": "Generates AI plan and auto-activates it" } },
        { "name": "GET Workout Today", "request": { "method": "GET", "url": "{{baseUrl}}/workouts/today", "description": "Today's day + exercises (auto-activates latest draft if needed)" } },
        { "name": "GET Active Workout Plan", "request": { "method": "GET", "url": "{{baseUrl}}/workouts/active" } },
        { "name": "GET Active Workout Session", "request": { "method": "GET", "url": "{{baseUrl}}/workouts/session/active" } },
        { "name": "POST Start Workout Session", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/workouts/session/start", "body": { "mode": "raw", "raw": "{\n  \"workoutPlanDayId\": \"{{workoutPlanDayId}}\"\n}" } } },
        { "name": "POST Log Set", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/workouts/exercises/{{workoutExerciseId}}/set", "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{workoutSessionId}}\",\n  \"reps\": \"10\",\n  \"weight\": 60,\n  \"restSeconds\": 90\n}" } } },
        { "name": "PATCH Update Set", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/workouts/exercises/{{workoutExerciseId}}/set/{{setId}}", "body": { "mode": "raw", "raw": "{\n  \"reps\": \"12\",\n  \"weight\": 62.5\n}" } } },
        { "name": "POST Complete Exercise", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/workouts/exercises/{{workoutExerciseId}}/complete", "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{workoutSessionId}}\"\n}" } } },
        { "name": "POST Skip Exercise", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/workouts/exercises/{{workoutExerciseId}}/complete", "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{workoutSessionId}}\",\n  \"skip\": true\n}" } } },
        { "name": "POST Pause Session", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/workouts/session/pause", "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{workoutSessionId}}\"\n}" } } },
        { "name": "POST Resume Session", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/workouts/session/resume", "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{workoutSessionId}}\"\n}" } } },
        { "name": "GET Session Detail", "request": { "method": "GET", "url": "{{baseUrl}}/workouts/session/{{workoutSessionId}}" } },
        { "name": "POST End Workout Session", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/workouts/session/end", "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{workoutSessionId}}\",\n  \"durationMinutes\": 45,\n  \"caloriesBurned\": 320\n}" } } },
        { "name": "GET Session History", "request": { "method": "GET", "url": "{{baseUrl}}/workouts/sessions/history?page=1&limit=20" } },
        { "name": "POST Hydration", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/hydration", "body": { "mode": "raw", "raw": "{\n  \"amountMl\": 250\n}" } } },
        { "name": "GET Hydration Today", "request": { "method": "GET", "url": "{{baseUrl}}/hydration/today" } },
        { "name": "POST AI Chat", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/ai/chat", "body": { "mode": "raw", "raw": "{\n  \"message\": \"I skipped lunch.\"\n}" }, "description": "Phase 8.3 — Context → Prompt → Gemini → Validator → Storage. Returns question/answer/timestamp/contextVersion" } },
        { "name": "POST AI Chat (existing session)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/ai/chat", "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{aiSessionId}}\",\n  \"message\": \"What should I eat for lunch?\"\n}" } } },
        { "name": "GET AI History", "request": { "method": "GET", "url": "{{baseUrl}}/ai/history?page=1&limit=20" } },
        { "name": "DELETE AI History Turn", "request": { "method": "DELETE", "url": "{{baseUrl}}/ai/history/{{aiHistoryId}}", "description": "Delete a Q/A turn (assistant message id) or an entire session id" } }
      ]
    },
    {
      "name": "08.2 — Daily Dashboard & Compliance",
      "item": [
        { "name": "GET Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard", "description": "Full daily dashboard: score, meals, workout, water, macros, streak, achievements" } },
        { "name": "GET Dashboard Today", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/today" } },
        { "name": "GET Dashboard Compliance", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/compliance" } },
        { "name": "GET Dashboard Streak", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/streak" } },
        { "name": "GET Dashboard Summary", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/summary" } }
      ]
    },
    {
      "name": "09 — Images (R2 optimize + Mongo)",
      "item": [
        {
          "name": "POST Upload Image",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/images",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "type", "value": "profile", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "description": "Optimizes to original/thumbnail/small/medium/large × webp/jpeg/avif, uploads to R2 under uploads/{userId}/{type}/{imageId}/, stores metadata in MongoDB user_images"
          }
        },
        { "name": "GET Images", "request": { "method": "GET", "url": "{{baseUrl}}/images?page=1&limit=20" } },
        { "name": "GET Images by type", "request": { "method": "GET", "url": "{{baseUrl}}/images?type=profile&page=1&limit=20" } },
        { "name": "GET Image by id", "request": { "method": "GET", "url": "{{baseUrl}}/images/{{imageId}}" } },
        { "name": "DELETE Image", "request": { "method": "DELETE", "url": "{{baseUrl}}/images/{{imageId}}" } }
      ]
    }
  ]
}
