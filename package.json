{
  "name": "services",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "submodules": {
    "db-schema": {
      "path": "db-schema",
      "repository": "git@github.com:memohit18/db-schema.git"
    }
  },
  "prisma": {
    "schema": "db-schema/postgres/prisma/schema.prisma",
    "migrations": "db-schema/postgres/prisma/migrations"
  },
  "scripts": {
    "submodule:init": "git submodule update --init --recursive",
    "submodule:pull": "git submodule update --init --recursive --remote db-schema",
    "prisma:generate": "dotenv -e .env -- prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .env -- prisma migrate deploy",
    "prisma:prepare": "npm run prisma:generate && npm run prisma:migrate:deploy",
    "prebuild": "npm run submodule:init && npm run prisma:generate",
    "postinstall": "npm run submodule:init && npm run prisma:generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "dotenv -e .env -- nest start",
    "start:dev": "dotenv -e .env -- nest start --watch",
    "start:debug": "dotenv -e .env -- nest start --debug --watch",
    "start:prod": "dotenv -e .env -- node dist/main",
    "questions:set-time-limits": "dotenv -e .env -- ts-node --transpile-only scripts/set-question-time-limits.ts",
    "questions:backfill-time-limits": "dotenv -e .env -- ts-node --transpile-only scripts/backfill-question-time-limits.ts",
    "llm:test": "dotenv -e .env -- ts-node --transpile-only scripts/test-llm-providers.ts",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@google/genai": "^2.9.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "groq-sdk": "^1.3.0",
    "ioredis": "^5.11.1",
    "mongoose": "^9.7.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
